{
  "name": "geoportal-ia-plan-specs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"node --watch backend/server.js\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node backend/server.js",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "test:postgis": "node --env-file=.env --test integration/postgis.test.js",
    "db:migrate": "docker compose exec -T db psql -v ON_ERROR_STOP=1 -U geoportal -d geoportal -f /docker-entrypoint-initdb.d/20_schema.sql -f /docker-entrypoint-initdb.d/40_geography_index.sql",
    "db:seed": "docker compose exec -T db psql -v ON_ERROR_STOP=1 -U geoportal -d geoportal -f /docker-entrypoint-initdb.d/30_seed.sql"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^5.0.0",
    "maplibre-gl": "^6.10.0",
    "pg": "^8.0.0",
    "pg-hstore": "^2.0.0",
    "sequelize": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
